# d.onl Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Values: 'development' or 'production'
# In development: no rewards, no payouts, domain verification + SSL only
APP_ENV=production
SITE_URL=https://d.onl

# =============================================================================
# POSTGRESQL DATABASE
# =============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=domain_mining
PG_USER=domain_user
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# CLICKHOUSE DATABASE
# =============================================================================
CH_HOST=localhost
CH_PORT=9000
CH_DATABASE=domain_mining
CH_USER=default
CH_PASSWORD=

# =============================================================================
# SECURITY
# =============================================================================
# CRITICAL: Generate a strong random secret for production (min 32 chars)
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=https://d.onl,https://www.d.onl

# =============================================================================
# WAVES BLOCKCHAIN
# =============================================================================
# Smart contract address (from deploying donl.ride)
DAPP_ADDRESS=3P_YOUR_DAPP_ADDRESS_HERE

# Oracle wallet address
ORACLE_ADDRESS=3N_YOUR_ORACLE_ADDRESS_HERE

# Oracle seed phrase (KEEP SECRET)
ORACLE_SEED=your twelve word seed phrase goes here

# Waves node URL (mainnet)
WAVES_NODE_URL=https://nodes.wavesnodes.com
WAVES_CHAIN_ID=W

# =============================================================================
# DNS VERIFICATION
# =============================================================================
# Your server's public IP for A-record verification
OUR_SERVER_IP=YOUR_SERVER_IP_HERE

# =============================================================================
# EMAIL (optional)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@d.onl
# SMTP_PASSWORD=email_password
