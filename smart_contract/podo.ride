@Callable(i)
func getBatchStatus(batchId: String) = {
  # ✨ NEW in v2.9: Query batch processing status
  # Public view function to check if a batch ID has been processed
  # Useful for oracle pre-flight checks to avoid failed transactions
  # 
  # Returns:
  # - isProcessed: true if this batch has already been paid out
  # - timestamp: when the batch was processed (0 if not processed)
  # - oracleVersion: current oracle version (for replay protection context)
  let batchKey = getBatchKey(batchId)
  let timestampKey = getBatchTimestampKey(batchId)
  let isProcessed = match getBoolean(this, batchKey) {
    case val:Boolean => val
    case _ => false
  }
  let timestamp =
    match getInteger(this, timestampKey) {
      case ts:Int => ts
      case _ =>
        match getInteger(this, "batch_ts_" + batchId) {
          case legacy:Int => legacy
          case _ => 0
        }
    }
  (
    [],
    (
      isProcessed,        # 1. Has this batch been processed?
      timestamp,          # 2. When was it processed (ms)?
      0                   # 3. Oracle version (not used in single oracle mode)
    )
  )
}

@Callable(i)
func getRateLimitStatus() = {
  # ✨ NEW in v2.9: Query current rate limit status
  # Public view function to check rate limit capacity before attempting payout
  # Prevents wasted gas on transactions that would fail due to rate limits
  # 
  # Returns:
  # - dailyRemaining: tokens that can still be distributed today
  # - hourlyRemaining: tokens that can still be distributed this hour
  # - intervalWaitMs: milliseconds until next payout allowed (0 if ready now)
  # - dailyUsed: tokens already distributed today
  # - hourlyUsed: tokens already distributed this hour
  # - canPayoutNow: true if interval check would pass
  let currentDay = getCurrentDay()
  let currentHour = getCurrentHour()
  let (_storedDay, dailyDist) = getPeriodState(KEY_DAILY_STATE_DAY, KEY_DAILY_STATE_AMOUNT, currentDay)
  let (_storedHour, hourlyDist) = getPeriodState(KEY_HOURLY_STATE_HOUR, KEY_HOURLY_STATE_AMOUNT, currentHour)
  let lastPayout = match getInteger(this, KEY_LAST_PAYOUT) {
    case val:Int => val
    case _ => 0
  }
  let timeSinceLastPayout = if (lastPayout == 0) then 0 else lastBlock.timestamp - lastPayout
  
  let dailyRemaining = getMaxDailyDistribution() - dailyDist
  let hourlyRemaining = getMaxHourlyDistribution() - hourlyDist
  let intervalWaitMs = if (lastPayout == 0 || timeSinceLastPayout >= MIN_PAYOUT_INTERVAL) 
    then 0 
    else MIN_PAYOUT_INTERVAL - timeSinceLastPayout
  let canPayoutNow = intervalWaitMs == 0
  
  (
    [],
    (
      dailyRemaining,      # 1. Tokens remaining today
      hourlyRemaining,     # 2. Tokens remaining this hour
      intervalWaitMs,      # 3. Wait time in milliseconds (0 = ready)
      dailyDist,           # 4. Tokens used today
      hourlyDist,          # 5. Tokens used this hour
      canPayoutNow         # 6. Can payout now? (boolean)
    )
  )
}


@Callable(i)
func updateLimits(newMaxDaily: Int, newMaxHourly: Int, newMaxIndividual: Int, newMaxBatch: Int) = {
  if (i.callerPublicKey != getAdminPubKey()) then
    throw("Only admin can update limits")
  else
  
  # v2.14: Strict bounds checking to prevent accidental misconfiguration
  if (newMaxDaily < MIN_DAILY_LIMIT) then
    throw("Daily limit too low. Minimum: " + toString(MIN_DAILY_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxDaily / 100000000) + " tokens")
  else if (newMaxDaily > MAX_DAILY_LIMIT) then
    throw("Daily limit too high. Maximum: " + toString(MAX_DAILY_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxDaily / 100000000) + " tokens")
  else if (newMaxHourly < MIN_HOURLY_LIMIT) then
    throw("Hourly limit too low. Minimum: " + toString(MIN_HOURLY_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxHourly / 100000000) + " tokens")
  else if (newMaxHourly > MAX_HOURLY_LIMIT) then
    throw("Hourly limit too high. Maximum: " + toString(MAX_HOURLY_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxHourly / 100000000) + " tokens")
  else if (newMaxIndividual < MIN_INDIVIDUAL_LIMIT) then
    throw("Individual limit too low. Minimum: " + toString(MIN_INDIVIDUAL_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxIndividual / 100000000) + " tokens")
  else if (newMaxIndividual > MAX_INDIVIDUAL_LIMIT) then
    throw("Individual limit too high. Maximum: " + toString(MAX_INDIVIDUAL_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxIndividual / 100000000) + " tokens")
  else if (newMaxBatch < MIN_BATCH_LIMIT) then
    throw("Batch limit too low. Minimum: " + toString(MIN_BATCH_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxBatch / 100000000) + " tokens")
  else if (newMaxBatch > MAX_BATCH_LIMIT) then
    throw("Batch limit too high. Maximum: " + toString(MAX_BATCH_LIMIT / 100000000) + " tokens, " +
          "Requested: " + toString(newMaxBatch / 100000000) + " tokens")
  # v2.14: Logical consistency checks
  else if (newMaxHourly > newMaxDaily) then
    throw("Hourly limit cannot exceed daily limit. " +
          "Hourly: " + toString(newMaxHourly / 100000000) + ", Daily: " + toString(newMaxDaily / 100000000))
  else if (newMaxIndividual > newMaxBatch) then
    throw("Individual limit cannot exceed batch limit. " +
          "Individual: " + toString(newMaxIndividual / 100000000) + ", Batch: " + toString(newMaxBatch / 100000000))
  else if (newMaxBatch > newMaxHourly) then
    throw("Batch limit cannot exceed hourly limit. " +
          "Batch: " + toString(newMaxBatch / 100000000) + ", Hourly: " + toString(newMaxHourly / 100000000))
  else
    [
      IntegerEntry(KEY_MAX_DAILY_DISTRIBUTION, newMaxDaily),
      IntegerEntry(KEY_MAX_HOURLY_DISTRIBUTION, newMaxHourly),
      IntegerEntry(KEY_MAX_INDIVIDUAL_AMOUNT, newMaxIndividual),
      IntegerEntry(KEY_MAX_BATCH_AMOUNT, newMaxBatch)
    ]
}

@Verifier(tx)
func verify() = {
  # Simplified verifier: Only check admin OR legacy single oracle
  let adminKey = getString(this, KEY_ADMIN_PUBKEY)
  match adminKey {
    case adminStr:String =>
      let adminPK = fromBase58String(adminStr)
      let adminSigned = proofForKeyExists(tx.bodyBytes, tx.proofs, adminPK)

      if (adminSigned) then true
      else
        match tx {
          case inv:InvokeScriptTransaction =>
            # Simple legacy oracle check
            legacyOracleMatches(inv.sender)
          case _ => throw("Transaction type not allowed. Only InvokeScriptTransaction permitted")
        }
    case _ =>
      # Contract not initialized - allow setScript signed by account owner for initial setup
      match tx {
        case stx:SetScriptTransaction => sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
        case itx:InvokeScriptTransaction =>
          # Allow init() call before admin is set, but only if caller matches sender
          if (itx.function == "init") then sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
          else throw("Admin public key not configured. Contract must be initialized first.")
    case _ => throw("Admin public key not configured. Contract must be initialized")
      }
  }
}


